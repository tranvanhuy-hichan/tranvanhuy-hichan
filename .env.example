# Sao chép thành .env.local rồi điền giá trị (lấy ở https://dashboard.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Domains: change these (and nothing in code) when moving to a new domain. Set the same ROOT_DOMAIN on the store.
# NEXT_PUBLIC_ROOT_DOMAIN=htstudio.cloud
# NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio.htstudio.cloud
# NEXT_PUBLIC_STORE_URL=https://htstudio.cloud
