# Sao chép thành .env.local rồi điền giá trị (lấy ở https://dashboard.emailjs.com)
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# Domains (lib/site.ts). Current production values; when moving to a new domain, change only these (same ROOT_DOMAIN as the store).
NEXT_PUBLIC_ROOT_DOMAIN=tranvanhuy.io.vn
NEXT_PUBLIC_PORTFOLIO_URL=https://portfolio.tranvanhuy.io.vn
NEXT_PUBLIC_STORE_URL=https://www.tranvanhuy.io.vn
